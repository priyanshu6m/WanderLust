<% layout("/layouts/boilerplate") %>

<style>
    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
    }

    .login-card {
        border: none;
        border-radius: 24px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.08);
    }

    .login-title {
        font-weight: 700;
        color: #222;
    }

    .form-control {
        border-radius: 12px;
        padding: 0.8rem 1rem;
    }

    .form-control:focus {
        border-color: #fe424d;
        box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.2);
    }

    .login-btn {
        background-color: #fe424d;
        border: none;
        border-radius: 12px;
        padding: 0.8rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }

    .login-btn:hover {
        background-color: #e63946;
        transform: translateY(-2px);
    }
    @media(max-width: 1200px){
        .login-title{
            white-space: nowrap;
        }
    }
    @media (max-width: 768px) {
        .login-container {
            min-height: auto;
            padding: 2rem 0;
        }

        .login-title {
            font-size: 1.8rem;
        }
    }

    @media (max-width: 576px) {
        .card-body {
            padding: 2rem 1.5rem !important;
        }

        .login-title {
            font-size: 1.6rem;
        }
    }
    @media (max-width: 380px){
        .login-title{
            font-size: 1.2rem;
        }
    }
</style>

<div class="container login-container">
    <div class="row justify-content-center w-100">

        <div class="col-lg-5 col-md-7 col-sm-10 col-11">

            <div class="card login-card">
                <div class="card-body p-5">

                    <h2 class="text-center mb-4 login-title">
                        Login to Wanderlust
                    </h2>

                    <form action="/login" method="POST" class="needs-validation" novalidate>

                        <div class="mb-3">
                            <label for="username" class="form-label">
                                Username
                            </label>

                            <input
                                type="text"
                                id="username"
                                class="form-control"
                                name="username"
                                placeholder="Enter your username"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter your username.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                class="form-control"
                                name="password"
                                placeholder="Enter your password"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter your password.
                            </div>
                        </div>

                        <button type="submit" class="btn login-btn w-100">
                            Login
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>
</div>