<%- layout('layouts/boilerplate') %>
<style>
  .filter-btn {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 0.7rem;
  }

</style>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Create New Listing</h3>
      <form
        action="/listings"
        method="POST"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            class="form-control"
            name="listing[title]"
            placeholder="Add a catchy title"
            required />
          <div class="valid-feedback">Title looks good!</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            placeholder="Description"
            required></textarea>
          <div class="invalid-feedback">Description should be valid</div>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Upload Listing Image</label>
          <input
            type="file"
            class="form-control"
            name="listing[image]"
            />
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              class="form-control"
              name="listing[price]"
              placeholder="1200"
              required />
            <div class="invalid-feedback">Price should be valid</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              class="form-control"
              name="listing[country]"
              placeholder="India"
              required />
            <div class="invalid-feedback">Country should be valid</div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            class="form-control"
            name="listing[location]"
            placeholder="Indore, Madhya Pradesh"
            required />
          <div class="invalid-feedback">Location should be valid</div>
        </div>
        <h6>Choose Filters for Your Listing</h6>
        <div class="filter-btn">
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-1-outlined" name="listing[filters]" value="room" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-1-outlined">Room</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-2-outlined" name="listing[filters]" value="iconic cities" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-2-outlined">Iconic cities</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-3-outlined" name="listing[filters]" value="mountains" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-3-outlined">Mountains</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-4-outlined" name="listing[filters]" value="castles" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-4-outlined">Castles</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-5-outlined" name="listing[filters]" value="amazing pools" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-5-outlined">Amazing Pools</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-6-outlined" name="listing[filters]" value="camping" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-6-outlined">Camping</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-7-outlined" name="listing[filters]" value="farms" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-7-outlined">Farms</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-8-outlined" name="listing[filters]" value="arctic" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-8-outlined">Arctic</label><br>
          </div>
          <div>
            <input type="checkbox" class="btn-check" id="btn-check-8-outlined" name="listing[filters]" value="beach" autocomplete="off">
            <label class="btn btn-outline-secondary" for="btn-check-8-outlined">Beach</label><br>
          </div>
        </div>

        <button type="submit" class="btn btn-dark add-btn mt-4 mb-5">Create</button>
      </form>
    </div>
  </div> 
</body>
